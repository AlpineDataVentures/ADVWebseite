---
import Base from "@/layouts/Base.astro";
import ContactSpotlightSection from "@/partials/ContactSpotlightSection.astro";
import HomepageLeadHeading from "@/partials/HomepageLeadHeading.astro";
import InsightCardsSection from "@/partials/InsightCardsSection.astro";
import ImageMod from "@/components/ImageMod.astro";
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

const aboutAdv = (await getEntry(
  "about-adv",
  "-index",
)) as CollectionEntry<"about-adv">;

const managingDirectors = [
  {
    src: "/images/about/gf_andreas.jpg",
    alt: "Andreas Klostermann",
  },
  {
    src: "/images/about/gf_ben.jpg",
    alt: "Benjamin Diez",
  },
  {
    src: "/images/about/gf_carsten.jpg",
    alt: "Dr. Carsten Hof",
  },
  {
    src: "/images/about/gf_julian.jpg",
    alt: "Julian Koller",
  },
];

const insightCards = [
  {
    icon: "FaUsers",
    titleStart: "Das ",
    titleHighlight: "Team",
    text: "Die Menschen hinter ADV: wer wir sind und wofür wir stehen",
    link: "/team/",
  },
  {
    icon: "FaMountainSun",
    titleStart: "",
    titleHighlight: "Warum",
    titleEnd: " ADV",
    text: "Alle Hintergründe zu unserem Geschäftsmodell, von Fixpreisen bis Skin in the Game",
    link: "/values/",
  },
  {
    icon: "FaStairs",
    titleHighlight: "Karriere",
    text: "Geile Projekte, steile Karriere, ADV! Komm zu uns ins Team!",
    link: "/career/",
  },
];

const { title, description, meta_title, image } = aboutAdv.data;
---

<Base
  title={title}
  meta_title={meta_title}
  image={image}
  description={description}
>
  <HomepageLeadHeading eyebrow="Über ADV" title="Data. Decision. Done." />

  <section class="section pt-2 pb-12 md:pb-16">
    <div class="container">
      <div class="row items-stretch gap-y-10">
        <div class="col-12 md:col-6">
          <div class="flex h-full flex-col justify-center text-left">
            <p
              class="font-secondary text-lg font-normal text-text dark:text-darkmode-text"
            >
              Der <strong>Mittelstand</strong> steht unter Druck: der Markt wird härter,
              der Wettbewerb schneller, und wer die eigenen Daten nicht nutzt, kann
              schnel den Anschluss verlieren.
            </p>
            <p
              class="font-secondary text-lg font-normal text-text dark:text-darkmode-text mt-4"
            >
              Wir begleiten Unternehmen aus dem Mittelstand auf dem Weg vom
              digitalisierten Betrieb zum datengetriebenen, effizienten
              Champion. Dabei planen wir professionell und packen bei der
              Umsetzung genauso selbst mit an!
            </p>
          </div>
        </div>

        <div class="col-12 md:col-6">
          <ImageMod
            src="/images/team_adv.jpg"
            alt="Team ADV"
            width={1600}
            height={720}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section py-8 pb-20">
    <div class="container">
      <h2 class="font-primary font-bold text-black dark:text-white">
        Ein paar Worte der
        <span class="adv-contact-gradient"> Geschäftsführung</span>
      </h2>

      <div class="mt-8 grid grid-cols-2 gap-6 lg:grid-cols-4">
        {
          managingDirectors.map((director) => (
            <ImageMod
              src={director.src}
              alt={director.alt}
              width={800}
              height={1200}
              class="h-full w-full rounded-xl object-cover"
              loading="lazy"
              format="webp"
            />
          ))
        }
      </div>

      <p
        class="mt-8 font-secondary text-lg font-normal text-text dark:text-darkmode-text"
      >
        2024 haben wir die ADV gegründet, weil wir Beratung anders machen
        wollten. Dabei passen wir uns dem Kunden an: mit manchen sind wir per du
        und direkt, mit anderen förmlicher – professionell bleibt es immer.
      </p>
      <p
        class="font-secondary text-lg font-normal text-text dark:text-darkmode-text mt-4"
      >
        Ein Grundsatz ist uns besonders wichtig, wir nennen ihn <strong
          >Skin in the Game</strong
        >: Wir arbeiten mit Fixpreisen statt Stundensätzen, den Preis für Ihr
        Projekt kennen Sie vorher. Dauert es länger als geplant, tragen wir das
        Risiko, nicht Sie. Deshalb zählt für unsere Berater der Projekterfolg
        und Ihre Zufriedenheit, nicht die Zahl gebuchter Stunden.
      </p>

      <InsightCardsSection
        titleHighlight="Mehr Einblicke"
        titleEnd=" in die ADV"
        cards={insightCards}
      />
    </div>
  </section>

  <ContactSpotlightSection
    titleStart="Mehr"
    titleHighlight="über uns als Firma"
    titleEnd="erfahren"
    leadText="Sie interessieren sich für ADV als Firma, unabhängig von einer konkreten Projektidee oder Herausforderung. Vielleicht wollen Sie wissen, wie wir arbeiten, wer hinter ADV steht, oder ob wir zu Ihrem Unternehmen passen."
    avatarSrc="/images/andreas.jpg"
    avatarAlt="Andreas"
    followupText="Kein Problem, Andreas hilft Ihnen gerne weiter. Buchen Sie einfach einen kurzen Termin, er kümmert sich gerne um Ihr Anliegen"
    buttonHref="https://calendly.com/andreas-klostermann-alpinedata/ersttermin"
    buttonLabel="Termin buchen"
    imageSrc="/images/kennenlernen.jpg"
    imageAlt="Gespräch mit Andreas"
  />
</Base>
