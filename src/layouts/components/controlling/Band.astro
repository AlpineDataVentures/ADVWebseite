---
/**
 * Shared section wrapper for the Controlling landing page.
 * Provides anchor spacing, a selectable background tone, and a centered content container.
 */
interface Props {
  /** Optional section ID for in-page navigation. */
  id?: string;
  /** Selects the standard page background or the light alternate background. */
  tone?: "body" | "light";
  /** Additional classes applied to the section element. */
  class?: string;
}

const { id, tone = "body", class: className = "" } = Astro.props as Props;

const tones = {
  body: "bg-body dark:bg-darkmode-body",
  light: "bg-light dark:bg-darkmode-light",
};
---

<section
  id={id}
  class={`section scroll-mt-20 ${tones[tone]} ${className}`}
>
  <div class="container">
    <slot />
  </div>
</section>
