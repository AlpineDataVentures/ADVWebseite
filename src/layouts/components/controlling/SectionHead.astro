---
import EyebrowTitle from "@/components/EyebrowTitle.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className = "" } = Astro.props as Props;
---

<div class={`mb-10 md:mb-12 ${className}`}>
  <EyebrowTitle eyebrow={eyebrow} title={title} />
  {
    lead && (
      <p class="mt-4 max-w-2xl font-secondary text-base text-text-light dark:text-darkmode-text-light md:text-lg">
        {lead}
      </p>
    )
  }
</div>
