---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className = "" } = Astro.props as Props;
---

<div class={`mb-10 grid gap-4 md:mb-12 ${className}`}>
  {
    eyebrow && (
      <p class="font-secondary text-sm font-bold uppercase tracking-[0.12em] text-[#008a55] dark:text-[#00CE7E]">
        {eyebrow}
      </p>
    )
  }
  <h2
    class="max-w-3xl font-primary text-h2-sm font-bold text-text-dark dark:text-darkmode-text-dark md:text-h2"
  >
    {title}
  </h2>
  {
    lead && (
      <p class="max-w-2xl font-secondary text-base text-text-light dark:text-darkmode-text-light md:text-lg">
        {lead}
      </p>
    )
  }
</div>
