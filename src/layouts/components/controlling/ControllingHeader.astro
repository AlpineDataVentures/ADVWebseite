---
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import CtaButton from "./CtaButton.astro";
import { CALENDLY_URL, navLinks } from "./content";
---

<header
  class="header sticky top-0 z-30 border-b border-border py-3! dark:border-darkmode-border"
>
  <nav class="navbar container gap-4" aria-label="Seitennavigation">
    <div class="flex items-center gap-3">
      <Logo />
      <span
        class="hidden font-primary text-lg font-bold text-[#008a55] dark:text-[#00CE7E] sm:inline"
      >
        / Controlling
      </span>
    </div>

    <ul class="ml-auto hidden items-center gap-6 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-secondary text-base font-semibold text-text-light transition hover:text-text-dark dark:text-darkmode-text-light dark:hover:text-darkmode-text-dark"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-4 lg:ml-0">
      <ThemeSwitcher className="" />
      <CtaButton href={CALENDLY_URL} small>Erstgespräch vereinbaren</CtaButton>
    </div>
  </nav>
</header>
