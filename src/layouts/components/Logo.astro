---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

interface Props {
  src?: string;
  srcDarkmode?: string;
  displayWidth?: number;
}

const { src, srcDarkmode, displayWidth } = Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const { theme_switcher }: { theme_switcher: boolean } = config.settings;
const configuredWidth = Number.parseInt(logo_width);
const configuredHeight = Number.parseInt(logo_height);
const imageWidth = displayWidth ? undefined : configuredWidth * 2;
const imageHeight = displayWidth ? undefined : configuredHeight * 2;
const imageStyle = displayWidth
  ? { width: `${displayWidth}px`, height: "auto", maxWidth: "100%" }
  : { height: `${configuredHeight}px`, width: `${configuredWidth}px` };
---

<a href="/" class="navbar-brand inline-block">
  {
    src || srcDarkmode || logo || logo_darkmode ? (
      <>
        <ImageMod
          src={src ? src : logo}
          class={`inline-block ${theme_switcher && "dark:hidden"}`}
          width={imageWidth}
          height={imageHeight}
          alt={title}
          style={imageStyle}
          format="webp"
        />
        {theme_switcher && (
          <ImageMod
            src={srcDarkmode ? srcDarkmode : logo_darkmode}
            class={"hidden dark:inline-block"}
            width={imageWidth}
            height={imageHeight}
            alt={title}
            style={imageStyle}
            format="webp"
          />
        )}
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
