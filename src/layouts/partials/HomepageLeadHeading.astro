---
import EyebrowTitle from "@/components/EyebrowTitle.astro";

interface Props {
  eyebrow: string;
  title: string;
  className?: string;
}

const { eyebrow, title, className = "" } = Astro.props as Props;
---

<section class={className}>
  <div class="container">
    <EyebrowTitle
      class="w-full text-left py-8 md:py-12"
      as="h1"
      size="h1"
      {eyebrow}
      {title}
    />
  </div>
</section>
