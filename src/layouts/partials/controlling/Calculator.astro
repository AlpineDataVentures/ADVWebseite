---
import Band from "@/components/controlling/Band.astro";
import SavingsCalculator from "@/components/controlling/SavingsCalculator";
import SectionHead from "@/components/controlling/SectionHead.astro";
import type { CollectionEntry } from "astro:content";

type CalculatorData = CollectionEntry<"controllingCalculator">["data"];
const { calculator } = Astro.props as { calculator: CalculatorData };
---

<Band id="rechner" tone="light">
  <SectionHead
    eyebrow={calculator.eyebrow}
    title={calculator.title}
    lead={calculator.lead}
  />
  <SavingsCalculator client:visible />
</Band>
