---
import EyebrowTitle from "@/components/EyebrowTitle.astro";
import CtaButton from "@/components/controlling/CtaButton.astro";
import MonthEndTimeline from "@/components/controlling/MonthEndTimeline.astro";
import { CALENDLY_URL, hero } from "@/components/controlling/content";
---

<section class="bg-body py-16 dark:bg-darkmode-body md:py-20">
  <div class="container">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="grid min-w-0 gap-6">
        <EyebrowTitle as="h1" size="h1" eyebrow={hero.eyebrow} title={hero.title} />
        <p
          class="max-w-xl font-secondary text-lg text-text-light dark:text-darkmode-text-light md:text-xl"
        >
          {hero.lead}
        </p>
        <div class="flex flex-wrap gap-3">
          <CtaButton href={CALENDLY_URL}>{hero.primaryCta}</CtaButton>
          <CtaButton href="#rechner" variant="outline">
            {hero.secondaryCta}
          </CtaButton>
        </div>
      </div>
      <MonthEndTimeline />
    </div>
  </div>
</section>
