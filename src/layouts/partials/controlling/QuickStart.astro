---
import Band from "@/components/controlling/Band.astro";
import CtaButton from "@/components/controlling/CtaButton.astro";
import SectionHead from "@/components/controlling/SectionHead.astro";
import { CALENDLY_URL, quickStart as qs } from "@/components/controlling/content";

const { offer, fixedPrice } = qs;
---

<Band id="einstieg">
  <SectionHead eyebrow={qs.eyebrow} title={qs.title} />

  <div class="grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
    <div class="grid min-w-0 gap-8">
      <ol class="grid">
        {
          qs.steps.map((step) => (
            <li class="grid gap-1.5 border-t border-border py-5 last:border-b sm:grid-cols-[96px_1fr] sm:gap-5 dark:border-darkmode-border">
              <time class="pt-0.5 font-secondary text-sm font-bold text-[#008a55] dark:text-[#00CE7E]">
                {step.when}
              </time>
              <div class="grid gap-1.5">
                <h3 class="font-primary text-h5 font-bold text-text-dark dark:text-darkmode-text-dark">
                  {step.title}
                </h3>
                <p class="font-secondary text-base text-text-light dark:text-darkmode-text-light">
                  {step.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <p
        class="border-l-2 border-[#00CE7E] pl-5 font-secondary text-base text-text-light dark:text-darkmode-text-light"
      >
        {qs.note}
      </p>
    </div>

    <aside
      class="grid min-w-0 gap-6 rounded-lg border border-border bg-light p-7 dark:border-darkmode-border dark:bg-darkmode-light"
    >
      <div>
        <p
          class="font-primary text-5xl font-bold leading-none text-[#008a55] dark:text-[#00CE7E]"
        >
          {offer.price}
        </p>
        <p class="mt-2 font-secondary text-sm text-text-light dark:text-darkmode-text-light">
          {offer.priceNote}
        </p>
      </div>

      {
        [
          { title: offer.receiveTitle, items: offer.receive },
          { title: offer.needTitle, items: offer.need },
        ].map((group) => (
          <div>
            <h4 class="mb-2 font-primary text-base font-bold text-text-dark dark:text-darkmode-text-dark">
              {group.title}
            </h4>
            <ul class="list-disc space-y-1 pl-5 font-secondary text-base text-text dark:text-darkmode-text-light">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }

      <CtaButton href={CALENDLY_URL}>{offer.cta}</CtaButton>

      <div
        class="grid grid-cols-[64px_1fr] items-center gap-4 border-t border-border pt-6 dark:border-darkmode-border"
      >
        <img
          src={offer.person.image}
          alt={offer.person.name}
          width="64"
          height="64"
          loading="lazy"
          class="h-16 w-16 rounded-full object-cover"
        />
        <div>
          <b class="block font-primary text-base font-bold text-text-dark dark:text-darkmode-text-dark">
            {offer.person.name}
          </b>
          <span class="font-secondary text-sm text-text-light dark:text-darkmode-text-light">
            {offer.person.text}
          </span>
        </div>
      </div>
    </aside>
  </div>

  <div
    class="mt-12 grid items-center gap-3 rounded-lg border-[1.5px] border-[#00CE7E] p-7 md:grid-cols-[auto_1fr] md:gap-x-10"
  >
    <strong
      class="font-primary text-4xl font-bold leading-none text-[#008a55] dark:text-[#00CE7E] md:text-5xl"
    >
      {fixedPrice.label}
    </strong>
    <div class="grid gap-2">
      <h3 class="font-primary text-h5 font-bold text-text-dark dark:text-darkmode-text-dark">
        {fixedPrice.title}
      </h3>
      <p class="max-w-3xl font-secondary text-base text-text-light dark:text-darkmode-text-light">
        {fixedPrice.text}
      </p>
    </div>
  </div>
</Band>
