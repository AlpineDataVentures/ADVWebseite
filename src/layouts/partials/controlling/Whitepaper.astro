---
import EyebrowTitle from "@/components/EyebrowTitle.astro";
import Band from "@/components/controlling/Band.astro";
import WhitepaperForm from "@/components/controlling/WhitepaperForm.astro";
import type { CollectionEntry } from "astro:content";

type WhitepaperData = CollectionEntry<"controllingWhitepaper">["data"];
const { whitepaper: wp } = Astro.props as { whitepaper: WhitepaperData };
---

<Band id="whitepaper">
  <div class="grid items-center gap-12 md:grid-cols-[1fr_minmax(0,300px)] md:gap-16">
    <div class="grid min-w-0 gap-5 text-left">
      <EyebrowTitle eyebrow={wp.eyebrow} title={wp.title} />
      <p class="max-w-2xl font-secondary text-base text-text-light dark:text-darkmode-text-light md:text-lg">
        {wp.lead}
      </p>
      <ul class="list-disc space-y-2 pl-5 font-secondary text-base text-text dark:text-darkmode-text-light">
        {wp.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
      <WhitepaperForm form={wp.form} />
    </div>

    <div
      aria-hidden="true"
      class="flex aspect-210/297 w-full max-w-75 -rotate-2 flex-col gap-4 justify-self-center rounded-xs bg-light p-7 shadow-[14px_14px_0_#dedede] dark:bg-darkmode-light dark:shadow-[14px_14px_0_#3a3a3a] max-md:max-w-55"
    >
      <span class="font-secondary text-sm font-bold uppercase tracking-[0.12em] text-[#008a55] dark:text-[#00CE7E]">
        {wp.coverLabel}
      </span>
      <strong class="font-primary text-3xl font-bold leading-tight text-text-dark dark:text-darkmode-text-dark">
        {wp.coverTitle}
      </strong>
      <span class="mt-auto border-t-2 border-[#00CE7E] pt-3 font-secondary text-xs text-text-light dark:text-darkmode-text-light">
        {wp.coverFoot}
      </span>
    </div>
  </div>
</Band>
