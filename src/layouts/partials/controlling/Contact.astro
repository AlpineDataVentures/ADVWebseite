---
import Band from "@/components/controlling/Band.astro";
import SectionHead from "@/components/controlling/SectionHead.astro";
import CtaButton from "@/components/controlling/CtaButton.astro";
import type { CollectionEntry } from "astro:content";
import { CALENDLY_URL } from "@/components/controlling/settings";

type ContactData = CollectionEntry<"controllingContact">["data"];
const { contact } = Astro.props as { contact: ContactData };
const { booking, form } = contact;
const inputClass =
  "mt-1 w-full min-w-0 rounded border border-border bg-body px-3 py-2.5 font-secondary text-base font-normal text-text-dark focus:border-[#00CE7E] focus:ring-[#00CE7E] dark:border-darkmode-border dark:bg-darkmode-body dark:text-darkmode-text-dark";
const labelClass =
  "block font-secondary text-sm font-bold text-text-dark dark:text-darkmode-text-dark";
const boxClass =
  "grid content-start gap-5 rounded-lg border border-border bg-body p-6 dark:border-darkmode-border dark:bg-darkmode-body md:p-8";
---

<Band id="kontakt">
  <SectionHead
    eyebrow={contact.eyebrow}
    title={contact.title}
    lead={contact.lead}
  />

  <div class="grid gap-6 lg:grid-cols-2">
    <div class={boxClass}>
      <h3 class="font-primary text-h4 font-bold text-text-dark dark:text-darkmode-text-dark">
        {booking.title}
      </h3>
      <ul class="list-disc space-y-2 pl-5 font-secondary text-base text-text dark:text-darkmode-text-light">
        {booking.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
      <div>
        <CtaButton href={CALENDLY_URL}>{booking.cta}</CtaButton>
      </div>
      <div class="grid gap-4 border-t border-border pt-5 dark:border-darkmode-border">
        {booking.people.map((person) => (
          <div class="flex items-center gap-4">
            <img
              src={person.image}
              alt={person.name}
              width="64"
              height="64"
              loading="lazy"
              class="h-16 w-16 shrink-0 rounded-full object-cover"
            />
            <div class="grid gap-0.5">
              <b class="font-secondary text-base text-text-dark dark:text-darkmode-text-dark">
                {person.name}
              </b>
              <span class="font-secondary text-sm text-text-light dark:text-darkmode-text-light">
                {person.role}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class={boxClass}>
      <h3 class="font-primary text-h4 font-bold text-text-dark dark:text-darkmode-text-dark">
        {form.title}
      </h3>
      <form
        class="grid gap-4"
        data-contact-form
        data-error={form.error}
        data-sending={form.sending}
      >
        <fieldset class="border-0 p-0">
          <legend class={`${labelClass} mb-2`}>{form.typeLegend}</legend>
          <div class="flex flex-wrap gap-2">
            {form.types.map((type, index) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="type"
                  value={type.value}
                  data-label={type.label}
                  data-submit={type.submit}
                  checked={index === 0}
                  class="peer sr-only"
                />
                <span class="block rounded-md border border-border px-3 py-2 font-secondary text-sm text-text-dark transition peer-checked:border-[#00CE7E] peer-checked:bg-[#00CE7E] peer-checked:font-bold peer-checked:text-black peer-focus-visible:ring-2 peer-focus-visible:ring-[#00CE7E] dark:border-darkmode-border dark:text-darkmode-text-dark">
                  {type.label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class={labelClass}>
            {form.name}
            <input
              class={inputClass}
              name="name"
              required
              maxlength="200"
              autocomplete="name"
            />
          </label>
          <label class={labelClass}>
            {form.company}
            <input
              class={inputClass}
              name="company"
              required
              maxlength="200"
              autocomplete="organization"
            />
          </label>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class={labelClass}>
            {form.email}
            <input
              class={inputClass}
              name="email"
              type="email"
              required
              maxlength="200"
              autocomplete="email"
            />
          </label>
          <label class={labelClass}>
            {form.phone}{" "}
            <em
              class="font-normal not-italic text-text-light dark:text-darkmode-text-light"
              data-phone-hint
            >
              ({form.phoneHint})
            </em>
            <input
              class={inputClass}
              name="phone"
              type="tel"
              maxlength="50"
              autocomplete="tel"
            />
          </label>
        </div>
        <label class={labelClass} data-when-wrap>
          {form.when}
          <select class={inputClass} name="when">
            {form.whenOptions.map((option) => (
              <option>{option}</option>
            ))}
          </select>
        </label>
        <label class={labelClass}>
          {form.message}{" "}
          <em class="font-normal not-italic text-text-light dark:text-darkmode-text-light">
            ({form.optional})
          </em>
          <textarea
            class={inputClass}
            name="message"
            rows="4"
            maxlength="3000"
            placeholder={form.messagePlaceholder}
          ></textarea>
        </label>

        <div
          class="absolute left-[-9999px] h-0 w-0 overflow-hidden"
          aria-hidden="true"
        >
          <label>
            Website{" "}
            <input
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </label>
        </div>

        <div>
          <button
            type="submit"
            data-submit-button
            class="rounded-md border border-[#00CE7E] bg-[#00CE7E] px-6 py-3 font-secondary text-base font-bold text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {form.types[0].submit}
          </button>
        </div>
        <small
          data-contact-message
          aria-live="polite"
          class="font-secondary text-sm text-text-light dark:text-darkmode-text-light"
        >
          {form.privacy}{" "}
          <a href="/datenschutz/" class="underline">
            {form.privacyLink}
          </a>
        </small>
      </form>
      <div hidden data-contact-success aria-live="polite" class="grid gap-1">
        <b class="font-secondary text-lg text-text-dark dark:text-darkmode-text-dark">
          {form.successTitle}
        </b>
        <p class="font-secondary text-base text-text-light dark:text-darkmode-text-light">
          {form.success}
        </p>
      </div>
    </div>
  </div>
</Band>

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-contact-form]")
    .forEach((formEl) => {
      const button = formEl.querySelector<HTMLButtonElement>(
        "[data-submit-button]",
      )!;
      const message = formEl.querySelector<HTMLElement>(
        "[data-contact-message]",
      )!;
      const success = formEl.parentElement!.querySelector<HTMLElement>(
        "[data-contact-success]",
      )!;
      const phone = formEl.querySelector<HTMLInputElement>("[name=phone]")!;
      const phoneHint = formEl.querySelector<HTMLElement>("[data-phone-hint]")!;
      const whenWrap = formEl.querySelector<HTMLElement>("[data-when-wrap]")!;
      const field = (name: string) =>
        formEl.querySelector<
          HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
        >(`[name=${name}]`)!;
      const selectedType = () =>
        formEl.querySelector<HTMLInputElement>("[name=type]:checked")!;

      const updateType = () => {
        const type = selectedType();
        button.textContent = type.dataset.submit ?? "";
        const callback = type.value === "rueckruf";
        phone.required = callback;
        phoneHint.hidden = !callback;
        whenWrap.hidden = !(callback || type.value === "demo");
      };
      formEl.addEventListener("change", updateType);
      updateType();

      formEl.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!formEl.reportValidity()) return;

        const [firstname, ...rest] = field("name").value.trim().split(/\s+/);
        const type = selectedType();
        const lines = [
          `Unternehmen: ${field("company").value}`,
          !whenWrap.hidden ? `Wunschzeit: ${field("when").value}` : "",
          field("message").value.trim()
            ? `\n${field("message").value.trim()}`
            : "",
        ].filter(Boolean);

        const originalLabel = button.textContent;
        button.disabled = true;
        button.textContent = formEl.dataset.sending ?? "";
        try {
          const response = await fetch("/.netlify/functions/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              firstname,
              lastname: rest.join(" ") || "-",
              email: field("email").value,
              phone: field("phone").value,
              reason: `${type.dataset.label} (ADV.Control)`,
              website: field("website").value,
              message: lines.join("\n"),
            }),
          });
          if (!response.ok) throw new Error();
          formEl.hidden = true;
          success.hidden = false;
        } catch {
          message.textContent = formEl.dataset.error ?? "";
          button.textContent = originalLabel;
          button.disabled = false;
        }
      });
    });
</script>
