---
import { markdownify } from "@/lib/utils/textConverter";
const { faq, compact = false } = Astro.props;
---

{
  faq.data.enable && (
    <section
      class:list={[
        "bg-white py-24 dark:bg-darkmode-body",
        compact && "faq-compact",
      ]}
    >
      <div class="container faq-container">
        {
          compact ? (
            <div class="faq-heading">
              <p class="faq-eyebrow">FAQ</p>
              <h2 class="font-primary font-bold text-black dark:text-white">
                {faq.data.title}
              </h2>
            </div>
          ) : (
            <h2 class="mb-8 font-primary font-bold text-black dark:text-white">
              {faq.data.title}
            </h2>
          )
        }

        <div class={compact ? "faq-list" : "space-y-6"}>
          {faq.data.items.map(
            (item: {
              question: string;
              answer_short: string;
              answer_long: string;
            }) => (
              <details
                class:list={[
                  "group",
                  compact
                    ? "faq-item"
                    : "rounded-2xl border border-black/80 bg-light px-7 py-5 transition-all duration-300 hover:-translate-y-1 hover:border-[#00CE7E] hover:shadow-[0_14px_30px_rgba(0,0,0,0.08)] dark:border-white/70 dark:bg-darkmode-light",
                ]}
              >
                <summary
                  class:list={[
                    compact
                      ? "faq-question"
                      : "flex cursor-pointer list-none items-center justify-between gap-4 font-primary text-h5 font-bold text-text-dark marker:hidden dark:text-darkmode-text-dark",
                  ]}
                >
                  <span set:html={markdownify(item.question)} />
                  {
                    !compact && (
                      <span
                        class="shrink-0 text-3xl leading-none transition-colors duration-300 transition-transform group-hover:text-[#00CE7E] group-open:rotate-45"
                        aria-hidden="true"
                      >
                        +
                      </span>
                    )
                  }
                </summary>

                <p
                  class:list={[
                    compact
                      ? "faq-answer font-secondary text-base text-text dark:text-darkmode-text"
                      : "mt-3 font-secondary text-base text-text dark:text-darkmode-text",
                  ]}
                >
                  <span
                    class="font-bold"
                    set:html={markdownify(item.answer_short)}
                  />{" "}
                  <span set:html={markdownify(item.answer_long)} />
                </p>
              </details>
            ),
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-compact .faq-container {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: start;
    gap: 3.5rem;
  }

  .faq-compact .faq-heading {
    display: grid;
    gap: 1rem;
  }

  .faq-compact .faq-eyebrow {
    color: #008a55;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .faq-compact .faq-list {
    min-width: 0;
    border-top: 1px solid #dedede;
  }

  .faq-compact .faq-item {
    padding: 1.125rem 0;
    border-bottom: 1px solid #dedede;
  }

  .faq-compact .faq-question {
    cursor: pointer;
    font-weight: 600;
  }

  .faq-compact .faq-answer {
    margin-top: 0.625rem;
    color: #5c5a5e;
  }

  :global(.dark) .faq-compact .faq-list,
  :global(.dark) .faq-compact .faq-item {
    border-color: #3a3a3a;
  }

  :global(.dark) .faq-compact .faq-eyebrow {
    color: #00ce7e;
  }

  :global(.dark) .faq-compact .faq-answer {
    color: #b4afb6;
  }

  @media (max-width: 900px) {
    .faq-compact .faq-container {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
