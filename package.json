{
  "name": "advwebseite",
  "version": "3.1.0",
  "description": "Alpine Data Ventures GmbH",
  "author": "Dr. Carsten Hof based on zeon.studio Template",
  "email": "info@alpinedata.de",
  "license": "UNLICENSED",
  "type": "module",
  "url": "https://alpinedata.de/",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "npm run generate-json && astro dev",
    "build": "npm run generate-json && astro build && node scripts/copy_prod.mjs",
    "build_branch": "npm run generate-json && astro build && node scripts/copy_branch.mjs",
    "preview": "astro preview",
    "format": "prettier -w ./src",
    "generate-domains": "node scripts/generate-domains-from-strapi.mjs",
    "generate-json": "node scripts/jsonGenerator.js && tsx scripts/generateCatalogSearchCorpus.mjs",
    "remove-darkmode": "node scripts/removeDarkmode.js && npm run format"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@nanostores/react": "^2.0.1",
    "@netlify/blobs": "^11.1.7",
    "astro": "^7.4.4",
    "astro-font": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.9.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "klaro": "^0.7.21",
    "lucide-react": "^1.65.0",
    "marked": "^18.1.2",
    "nanostores": "^1.5.5",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "resend": "^6.35.0",
    "sharp": "0.35.5",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@netlify/functions": "^6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-eslint-parser": "^3.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@babel/eslint-parser": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true
  }
}
